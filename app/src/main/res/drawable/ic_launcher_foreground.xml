<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        Launcher foreground — sama persis dengan SplashScreen.kt:
          1. Lingkaran soft purple (primaryPurple alpha 10%) → #1A5A2A82
          2. Lightbulb icon dari Material Design (path data sama dengan Icons.Default.Lightbulb)
             di-scale 3x dan di-center di canvas 108x108

        Safe zone: 18dp - 90dp (konten berada di 30-78, aman)
    -->

    <!-- Lingkaran soft purple: sama dengan Box(background=primaryPurple.copy(alpha=0.1f)) di splash -->
    <path
        android:fillColor="#1A5A2A82"
        android:pathData="M54,22 A32,32 0 1 1 54,86 A32,32 0 1 1 54,22Z" />

    <!--
        Lightbulb icon — Material Design path persis, di-transform:
        translateX=30, translateY=30, scale=2  → icon 48dp centered di (54,54)
        Path original: 24x24 viewbox (sama dengan Icons.Default.Lightbulb)
    -->
    <group
        android:translateX="30"
        android:translateY="30"
        android:scaleX="2"
        android:scaleY="2"
        android:pivotX="0"
        android:pivotY="0">

        <!-- Bagian bawah bohlam (kaki/base) -->
        <path
            android:fillColor="#5A2A82"
            android:pathData="M9,21c0,0.55 0.45,1 1,1h4c0.55,0 1,-0.45 1,-1v-1L9,20v1z" />

        <!-- Badan bohlam utama -->
        <path
            android:fillColor="#5A2A82"
            android:pathData="M12,2C8.14,2 5,5.14 5,9c0,2.38 1.19,4.47 3,5.74L8,17c0,0.55 0.45,1 1,1h6c0.55,0 1,-0.45 1,-1v-2.26C17.81,13.47 19,11.38 19,9C19,5.14 15.86,2 12,2z" />

    </group>

</vector>